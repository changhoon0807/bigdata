    "        ('scale', StandardScaler()),\n",
    "        ('lr', LinearRegression())\n",
    "    ]),\n",
    "    'Ridge': Pipeline([\n",
    "        ('scale', StandardScaler()),\n",
    "        ('ridge', Ridge(alpha=1.0, random_state=42))\n",
    "    ]),\n",
    "    'Lasso': Pipeline([\n",
    "        ('scale', StandardScaler()),\n",
    "        ('lasso', Lasso(alpha=0.1, random_state=42))\n",
    "    ]),\n",
    "    'ElasticNet': Pipeline([\n",
    "        ('scale', StandardScaler()),\n",

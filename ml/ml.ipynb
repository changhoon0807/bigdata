    "print('-'*50)\n",
    "\n",
    "for name in results: # 폴드별 RMSE 평균\n",
    "    rmses = []\n",
    "    for actual, pred in zip(results[name]['actual'], results[name]['pred']):\n",
    "        y_true = actual.values\n",
    "        y_pred = pred.values\n",
    "        rmses.append(np.sqrt(mean_squared_error(y_true, y_pred)))\n",
